def truncate_middle(s, max_len):
    if max_len < 1:
        raise ValueError("max_len должно быть больше или равно 1")
    if len(s) <= max_len:
        return s
    if max_len < 3:
        raise ValueError("max_len должно быть больше или равно 3 для укорочения строки")

    # Рассчитываем количество символов с начала и конца, которые будут сохранены
    part_length = (max_len - 3) // 2
    start = s[:part_length]
    end = s[-part_length:]

    # В случае нечетного max_len, добавляем один символ к началу
    if len(start) + len(end) + 3 < max_len:
        start += s[part_length]

    return f"{start}...{end}"


# Примеры
print(truncate_middle("hello world", 8))  # "hel...ld"
print(truncate_middle("hi", 10))  # "hi"
print(truncate_middle("hello", 3))  # "..."
print(truncate_middle("hello", 5))  # "hello"
try:
    print(truncate_middle("hello", 2))  # Вызывает ValueError
except ValueError as e:
    print(e)
